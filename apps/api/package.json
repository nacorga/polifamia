{
  "name": "@polifamia/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b && vitest run",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker/main.js",
    "dev": "tsc -b && node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "dev:worker": "tsc -b && node --env-file-if-exists=../../.env --enable-source-maps dist/worker/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -b && node --env-file-if-exists=../../.env dist/db/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@polifamia/connectors": "workspace:*",
    "@polifamia/contracts": "workspace:*",
    "@polifamia/investigation": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
