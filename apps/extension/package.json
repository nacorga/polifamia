{
  "name": "@polifamia/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "tsc -b ../../packages/contracts && vitest run",
    "e2e": "WXT_API_URL=http://localhost:3199 wxt build --mode e2e && playwright test"
  },
  "dependencies": {
    "@polifamia/contracts": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.3",
    "wxt": "0.21.4",
    "pg": "8.23.1",
    "@types/pg": "8.23.1"
  }
}
