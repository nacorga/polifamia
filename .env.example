# Servidor (nunca en la extensión)
DATABASE_URL=postgres://polifamia:polifamia@localhost:5432/polifamia
# PEM de la CA de la BD (App Platform: ${db.CA_CERT}). Vacío en local, sin TLS.
DATABASE_CA_CERT=
PORT=3100
# demo | real — demo produce resultados marcados DEMO
INVESTIGATION_MODE=demo
# Límites por investigación
JOB_TIMEOUT_MS=60000
JOB_MAX_LLM_CALLS=6
JOB_MAX_TOKENS=40000
JOB_MAX_DOCUMENTS=12
JOB_RETRY_LIMIT=2
# Presupuesto global diario (EUR) y rate limit por IP/installId
DAILY_BUDGET_EUR=5
RATE_LIMIT_PER_MINUTE=20
# Saltos de proxy de confianza para la IP del cliente (App Platform: 1; local: 0)
TRUST_PROXY=0
# Modelos LLM (configurables; registrar coste por llamada) y máximo de claims por vídeo
LLM_MODEL_EXTRACT=claude-haiku-5-5
LLM_MODEL_SYNTH=claude-opus-5-5
CLAIMS_MAX=10
# Documentos institucionales autorizados (por defecto corpus/documents)
# CORPUS_DIR=
# Claves (solo modo real; sin ANTHROPIC_API_KEY cada job termina FAILED/no_llm_key)
ANTHROPIC_API_KEY=
FACTCHECK_API_KEY=
