# Servidor (nunca en la extensión)
DATABASE_URL=postgres://polifamia:polifamia@localhost:5432/polifamia
PORT=3100
# demo | real — demo produce resultados marcados DEMO
INVESTIGATION_MODE=demo
# Límites por investigación
JOB_TIMEOUT_MS=60000
JOB_MAX_LLM_CALLS=6
JOB_MAX_TOKENS=40000
JOB_MAX_DOCUMENTS=12
JOB_RETRY_LIMIT=2
# Presupuesto global diario (EUR) y rate limit por IP/installId
DAILY_BUDGET_EUR=5
RATE_LIMIT_PER_MINUTE=20
# Claves (solo modo real)
ANTHROPIC_API_KEY=
FACTCHECK_API_KEY=
